# QET Agent Accelerator Environment Configuration Example
# Copy to .env and configure local values

# Target Execution Mode Settings
QET_PLAYWRIGHT_UI_ENABLED=true
QET_URL_EXECUTION_ENABLED=false
QET_API_TESTING_ENABLED=false
QET_PERFORMANCE_TESTING_ENABLED=false
QET_ACCESSIBILITY_EXECUTION_ENABLED=false
QET_SECURITY_SCANNING_ENABLED=false

# Controlled Playwright Non-Production Host
QET_TEST_BASE_URL=http://localhost:8501
QET_ALLOWED_TEST_HOST=localhost

# Optional API Key (Never log or commit raw keys)
GEMINI_API_KEY=replace_with_your_gemini_api_key
